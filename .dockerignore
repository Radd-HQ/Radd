# Keep the image build context lean (Containerfile copies what it needs).
.git
**/__pycache__
server/.venv
web/node_modules
web/dist
sdk/.venv
docs
research
# Local secrets: COPY server/ ./ would put server/.env where the app reads it (config.py env_file=".env").
**/.env
# Regenerated by the web stage; local copies are stale or dangling (absolute symlinks).
**/ui/node_modules
**/ui/dist
**/*.tsbuildinfo
# Local state, caches, proof output, agent workspace.
**/var
**/.pytest_cache
**/.ruff_cache
**/scripts/*.png
.claude
.mcp.json
# Not built into the image (build-all tolerates a missing examples/).
examples
