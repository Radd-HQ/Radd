{
  // What every plugin UI package compiles with: its tsconfig.json is
  // {"extends": "@radd/plugin-sdk/tsconfig.plugin.json", "include": ["src"]}.
  // `include` stays per package: it resolves against the file that declares it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}
